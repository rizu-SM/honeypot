# Honeypot ports
SSH_PORT=2222
HTTP_PORT=8080
FTP_PORT=2121
TELNET_PORT=2323
DASHBOARD_PORT=5000

# Storage
DATA_DIR=data
LOG_DIR=logs

# GeoIP cache size
GEOIP_CACHE_SIZE=1024

# Optional: AbuseIPDB API key for threat reputation scores
ABUSEIPDB_API_KEY=

# Optional: Discord webhook for attack alerts
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_THRESHOLD=10

# Dashboard secret key — change this in production!
DASHBOARD_SECRET_KEY=change-me-in-production

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
